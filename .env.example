# CTFd
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# CLIs for the claude-sdk/* and codex/* backends (command on PATH or a path).
# They use your own logins/config. Shell aliases are not visible here: point
# at the real command or wrapper, e.g. CLAUDE_CLI=ourclaude.
# CLAUDE_CLI=claude
# CODEX_CLI=codex
